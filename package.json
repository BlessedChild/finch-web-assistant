{
  "name": "finch-web-assistant",
  "version": "1.0.3",
  "description": "Kimi-powered browser tool: let Finch operate websites in your Chrome browser through Kimi WebBridge.",
  "author": "Arthur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlessedChild/finch-web-assistant.git"
  },
  "homepage": "https://github.com/BlessedChild/finch-web-assistant#readme",
  "bugs": {
    "url": "https://github.com/BlessedChild/finch-web-assistant/issues"
  },
  "keywords": [
    "finch",
    "finch-mini-tool",
    "kimi",
    "webbridge",
    "browser-automation",
    "chrome"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "i18n",
    "skills",
    "icon.png",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "doctor": "npx @finchtoys/minitools doctor .",
    "prepublishOnly": "npm run check && npm run build && npm run doctor"
  },
  "devDependencies": {
    "@finchtoys/minitool-api": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "finch": {
    "manifestVersion": 1,
    "id": "kimi-webbridge",
    "name": "Kimi Web Assistant",
    "description": "Kimi-powered browser tool for Finch. Installs or starts the local Kimi WebBridge component, uses the Kimi WebBridge Chrome extension, and talks to 127.0.0.1:10086 only. Connect your browser once to get started.",
    "miniToolType": "community",
    "categories": [
      "productivity"
    ],
    "main": "dist/index.js",
    "activationEvents": [
      "onStartup"
    ],
    "contributes": {
      "tools": true,
      "skills": true,
      "composerActions": [
        {
          "id": "kimi-webbridge-status",
          "icon": "globe",
          "tooltip": "Kimi Web Assistant"
        }
      ]
    },
    "permissions": {
      "filesystem": "none",
      "network": true,
      "shell": true
    }
  }
}
